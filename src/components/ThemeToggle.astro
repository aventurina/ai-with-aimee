---
// Light/dark mode toggle. Pairs with the blocking init script that must be
// placed in <head> (see partials/theme-init.astro) to avoid a flash of the
// wrong theme on page load.
---

<button id="theme-toggle" class="theme-toggle" type="button" aria-label="Toggle dark mode" title="Toggle dark mode">
    <span id="theme-icon" aria-hidden="true">🌙</span>
</button>

<script is:inline>
    (function () {
        function currentTheme() {
            return document.documentElement.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
        }

        function updateIcon() {
            var icon = document.getElementById('theme-icon');
            if (icon) {
                icon.textContent = currentTheme() === 'dark' ? '☀️' : '🌙';
            }
        }

        function init() {
            updateIcon();
            var btn = document.getElementById('theme-toggle');
            if (!btn) return;
            btn.addEventListener('click', function () {
                var next = currentTheme() === 'dark' ? 'light' : 'dark';
                document.documentElement.setAttribute('data-theme', next);
                try {
                    localStorage.setItem('theme', next);
                } catch (e) {
                    /* ignore, e.g. private browsing */
                }
                updateIcon();
            });
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', init);
        } else {
            init();
        }
    })();
</script>
